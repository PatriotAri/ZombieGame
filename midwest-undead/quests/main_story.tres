[sub_resource type="Resource" id="Resource_sidnm"]
script = ExtResource("1_xenh3")
lines = Array[String](["...You're back. What did you find?", "Overrun. All of them?", "Damn it. I knew those people. The Harlans. Old Mrs. Pruitt. The Okafor kids.", "If the Westside barricades couldn't hold, nothing in this town is as safe as we've been telling ourselves.", "Here. You earned this, and then some.", "And here's our next move. We stop hiding behind this fence and take back the blocks around it.", "Every one of those things on the streets around the station. Clear them out. Board up what you can so they stay out.", "Do that and word gets around. Traders follow safe streets."])

[sub_resource type="Resource" id="Resource_mb0i6"]
script = ExtResource("3_1q70k")
nodes = Array[ExtResource("1_xenh3")]([SubResource("Resource_sidnm")])

