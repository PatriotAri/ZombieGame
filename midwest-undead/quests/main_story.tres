[sub_resource type="Resource" id="Resource_8j8kd"]
script = ExtResource("1_xenh3")
lines = Array[String](["A trader in our own yard, and a woodworker. Almost feels like a town again.", "Still working out what comes next. Keep your head down, and keep that gun clean."])

[sub_resource type="Resource" id="Resource_2l1v6"]
script = ExtResource("3_1q70k")
nodes = Array[ExtResource("1_xenh3")]([SubResource("Resource_8j8kd")])

[sub_resource type="Resource" id="Resource_4k1jf"]
script = ExtResource("1_xenh3")
lines = Array[String](["Good, you're up. Listen. We've lost contact with the Westside safe house.", "Eleven people holed up there. Families, mostly. They checked in on the radio every night like clockwork.", "Three nights ago they missed the call. Nothing since.", "Could be a dead battery. Could be worse. I can't spare a guard off the towers to find out.", "It's way out on the west end of 7th Street, past Main and past the houses, across from the gas station. Get over there, see what happened, and come back and tell me.", "Trade with the Quartermaster if you need supplies. And keep it quiet out there. Gunfire brings every one of them for blocks."])

[sub_resource type="Resource" id="Resource_ds2b4"]
script = ExtResource("3_1q70k")
nodes = Array[ExtResource("1_xenh3")]([SubResource("Resource_4k1jf")])

[sub_resource type="Resource" id="Resource_od68d"]
script = ExtResource("1_xenh3")
lines = Array[String](["Good, you're up. Listen. We've lost contact with the Westside safe house, and I need someone to...", "...Hold on. You've got that look. You've already been out west, haven't you?", "Overrun. All eleven of them?", "Damn it. I was about to send you out there to find exactly that.", "You saved me a day of wondering, and yourself a trip. Here. You've earned this.", "And here's our next move. We stop hiding behind this fence and take back the blocks around it.", "Every one of those things on the streets around the station. Clear them out. Board up what you can so they stay out.", "Do that and word gets around. Traders follow safe streets."])

[sub_resource type="Resource" id="Resource_ivjos"]
script = ExtResource("3_1q70k")
nodes = Array[ExtResource("1_xenh3")]([SubResource("Resource_od68d")])

