[resource]
script = ExtResource("4_7idwf")
id = "main_story"
title = "The Westside Safe House"
description = "The Police Chief holds the station on 7th Street. Help him take the town back, one block at a time."
main = true
giver = "Police Chief"
steps = Array[ExtResource("5_f6hae")]([SubResource("Resource_rvmoo"), SubResource("Resource_7g6ca"), SubResource("Resource_cjpo7"), SubResource("Resource_4xo8l"), SubResource("Resource_0ubbd"), SubResource("Resource_7p84h"), SubResource("Resource_xs73y")])
afterword = SubResource("Resource_2l1v6")
event_stories = Dictionary[String, String]({
"safe_house_reached": "The barricade is torn open. The windows are smashed in.
Nobody answered the radio because nobody is left.",
"trader_found": "A trader's wagon has pulled into the station yard.",
"woodworker_found": "The woodworker has set up in the station yard.
Bring him planks, plywood and scrap metal and he'll build for you."
})
