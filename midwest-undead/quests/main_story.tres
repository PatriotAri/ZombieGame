[sub_resource type="Resource" id="Resource_yenkq"]
script = ExtResource("1_xenh3")
lines = Array[String](["You did it. It's quiet around here. First time in months.", "Give it time. Anyone out there with goods to sell will hear about it. Go see what else is out there."])

