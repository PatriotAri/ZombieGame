[sub_resource type="Resource" id="Resource_ris5m"]
script = ExtResource("1_xenh3")
lines = Array[String](["The trader told you too? A woodworker, held at that bandit camp north of 7th.", "Someone who can build is worth more to us than all the ammo in town. Watch towers, fences, gates.", "Get him out of there. Quietly, if you can."])

