[sub_resource type="Resource" id="Resource_ltkov"]
script = ExtResource("1_v4fgb")
lines = Array[String](["Bandages are holding out, thanks to you."])

[sub_resource type="Resource" id="Resource_omaji"]
script = ExtResource("4_j0bl5")
nodes = Array[ExtResource("1_v4fgb")]([SubResource("Resource_ltkov")])

[sub_resource type="Resource" id="Resource_q3fst"]
script = ExtResource("2_do25d")
text = "What's in it for me?"
next = "pay"

[sub_resource type="Resource" id="Resource_hb8ug"]
script = ExtResource("2_do25d")
text = "I'll get it."
next = "thanks"
action = "accept"

[sub_resource type="Resource" id="Resource_07ilw"]
script = ExtResource("2_do25d")
text = "Not now."
action = "decline"

[sub_resource type="Resource" id="Resource_t0wu0"]
script = ExtResource("1_v4fgb")
lines = Array[String](["You look like you can handle yourself.", "We're out of bandages. The gas station out west kept a first-aid kit behind the register."])
replies = Array[ExtResource("2_do25d")]([SubResource("Resource_q3fst"), SubResource("Resource_hb8ug"), SubResource("Resource_07ilw")])

[sub_resource type="Resource" id="Resource_cdryl"]
script = ExtResource("2_do25d")
text = "Deal."
next = "thanks"
action = "accept"

[sub_resource type="Resource" id="Resource_q0e5y"]
script = ExtResource("2_do25d")
text = "Not for that."
action = "decline"

[sub_resource type="Resource" id="Resource_esej7"]
script = ExtResource("1_v4fgb")
id = "pay"
lines = Array[String](["Sixty dollars and a health pack of your own. Fair?"])
replies = Array[ExtResource("2_do25d")]([SubResource("Resource_cdryl"), SubResource("Resource_q0e5y")])

[sub_resource type="Resource" id="Resource_ii5dk"]
script = ExtResource("1_v4fgb")
id = "thanks"
lines = Array[String](["Good. Two days, tops: people here are hurting."])

[sub_resource type="Resource" id="Resource_vnxs2"]
script = ExtResource("4_j0bl5")
nodes = Array[ExtResource("1_v4fgb")]([SubResource("Resource_t0wu0"), SubResource("Resource_esej7"), SubResource("Resource_ii5dk")])

[sub_resource type="Resource" id="Resource_topu6"]
script = ExtResource("10_4a3lu")
marker = "gas_station"
radius = 15.0
text = "Find the first-aid kit at the gas station"
map_label = "Gas station"

[sub_resource type="Resource" id="Resource_t6wna"]
script = ExtResource("1_v4fgb")
lines = Array[String](["The gas station, out west. Behind the register."])

[sub_resource type="Resource" id="Resource_3w1ww"]
script = ExtResource("4_j0bl5")
nodes = Array[ExtResource("1_v4fgb")]([SubResource("Resource_t6wna")])

[sub_resource type="Resource" id="Resource_4n4te"]
script = ExtResource("7_qpjms")
id = "find_kit"
objectives = Array[ExtResource("9_8hsxn")]([SubResource("Resource_topu6")])
reminder = SubResource("Resource_3w1ww")

[sub_resource type="Resource" id="Resource_wuy8i"]
script = ExtResource("1_v4fgb")
lines = Array[String](["You found it. That's a few people who'll sleep easier tonight.", "Here, as promised."])

[sub_resource type="Resource" id="Resource_t03nq"]
script = ExtResource("4_j0bl5")
nodes = Array[ExtResource("1_v4fgb")]([SubResource("Resource_wuy8i")])

[sub_resource type="Resource" id="Resource_4h0c3"]
script = ExtResource("11_crc5v")
npc = "quartermaster"
dialogue = SubResource("Resource_t03nq")
text = "Bring the first-aid kit to the Quartermaster"

[sub_resource type="Resource" id="Resource_75g5x"]
script = ExtResource("7_qpjms")
id = "bring_back"
objectives = Array[ExtResource("9_8hsxn")]([SubResource("Resource_4h0c3")])

[resource]
script = ExtResource("6_jkgfn")
id = "medicine_run"
title = "Medicine Run"
description = "The Quartermaster is out of bandages. There may be a first-aid kit at the gas station."
giver = "quartermaster"
offer = SubResource("Resource_vnxs2")
stages = Array[ExtResource("7_qpjms")]([SubResource("Resource_4n4te"), SubResource("Resource_75g5x")])
time_limit_hours = 48.0
reward_money = 60
reward_items = Dictionary[String, int]({
"health_pack": 1
})
afterword = SubResource("Resource_omaji")
