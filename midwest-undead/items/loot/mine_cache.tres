[gd_resource type="Resource" script_class="LootTable" format=3]

[ext_resource type="Script" path="res://items/loot_roll.gd" id="1_roll"]
[ext_resource type="Script" path="res://items/loot_pick.gd" id="2_pick"]
[ext_resource type="Script" path="res://items/loot_table.gd" id="3_table"]

[sub_resource type="Resource" id="Resource_p0"]
script = ExtResource("2_pick")
item = "dynamite"
max_amount = 3

[sub_resource type="Resource" id="Resource_r0"]
script = ExtResource("1_roll")
chance = 0.5
items = Array[ExtResource("2_pick")]([SubResource("Resource_p0")])

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("2_pick")
item = "steel_bar"
max_amount = 3

[sub_resource type="Resource" id="Resource_r1"]
script = ExtResource("1_roll")
chance = 0.6
items = Array[ExtResource("2_pick")]([SubResource("Resource_p1")])

[sub_resource type="Resource" id="Resource_p2"]
script = ExtResource("2_pick")
item = "scrap_metal"
max_amount = 4

[sub_resource type="Resource" id="Resource_r2"]
script = ExtResource("1_roll")
chance = 0.6
items = Array[ExtResource("2_pick")]([SubResource("Resource_p2")])

[sub_resource type="Resource" id="Resource_p3"]
script = ExtResource("2_pick")
item = "sheet_metal"
max_amount = 2

[sub_resource type="Resource" id="Resource_r3"]
script = ExtResource("1_roll")
chance = 0.4
items = Array[ExtResource("2_pick")]([SubResource("Resource_p3")])

[sub_resource type="Resource" id="Resource_p4"]
script = ExtResource("2_pick")
item = "gas_can"

[sub_resource type="Resource" id="Resource_r4"]
script = ExtResource("1_roll")
chance = 0.25
items = Array[ExtResource("2_pick")]([SubResource("Resource_p4")])

[sub_resource type="Resource" id="Resource_p5"]
script = ExtResource("2_pick")
item = "lantern"

[sub_resource type="Resource" id="Resource_r5"]
script = ExtResource("1_roll")
chance = 0.15
items = Array[ExtResource("2_pick")]([SubResource("Resource_p5")])

[sub_resource type="Resource" id="Resource_p6"]
script = ExtResource("2_pick")
item = "shotgun_shells"
min_amount = 2
max_amount = 6

[sub_resource type="Resource" id="Resource_r6"]
script = ExtResource("1_roll")
chance = 0.2
items = Array[ExtResource("2_pick")]([SubResource("Resource_p6")])

[resource]
script = ExtResource("3_table")
rolls = Array[ExtResource("1_roll")]([SubResource("Resource_r0"), SubResource("Resource_r1"), SubResource("Resource_r2"), SubResource("Resource_r3"), SubResource("Resource_r4"), SubResource("Resource_r5"), SubResource("Resource_r6")])
