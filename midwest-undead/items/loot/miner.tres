[gd_resource type="Resource" script_class="LootTable" format=3]

[ext_resource type="Script" path="res://items/loot_roll.gd" id="1_roll"]
[ext_resource type="Script" path="res://items/loot_pick.gd" id="2_pick"]
[ext_resource type="Script" path="res://items/loot_table.gd" id="3_table"]

[sub_resource type="Resource" id="Resource_p0"]
script = ExtResource("2_pick")
item = "dynamite"
max_amount = 2

[sub_resource type="Resource" id="Resource_r0"]
script = ExtResource("1_roll")
chance = 0.35
items = Array[ExtResource("2_pick")]([SubResource("Resource_p0")])

