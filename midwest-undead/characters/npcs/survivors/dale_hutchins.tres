script = ExtResource("1_rqp2s")
lines = Array[String](["Who's there? ...You're not one of them. Thank God.", "Dale Hutchins. Had a farm out past the grain elevator. Boarded myself in here when the town went.", "Station's got walls and people? I'll take it. I can still swing a shovel."])

