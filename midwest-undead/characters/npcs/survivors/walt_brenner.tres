[sub_resource type="Resource" id="Resource_k6wgi"]
script = ExtResource("1_k5uit")
lines = Array[String](["Hands where I can see 'em. ...Fine. You're no bandit.", "Walt Brenner. Ran the machine shop on Route 9 for thirty years. Lathes, presses, reloading gear.", "Got people at the police station? Then I'll come. Somebody's got to keep you in bullets."])

