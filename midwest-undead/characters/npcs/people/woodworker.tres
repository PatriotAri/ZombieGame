[sub_resource type="Resource" id="Resource_pl46n"]
script = ExtResource("3_pl46n")
lines = Array[String](["Easy... easy. You're not one of them.", "They grabbed me off the road a week back. Made me patch up their junk, kept me tied to this post the rest of the time.", "I'm a woodworker. Scaffolding, lookout posts, fences, gates. If it's made of wood, I can build it.", "The police station? Then that's where I'm going. Find me in the yard. I owe you one."])

